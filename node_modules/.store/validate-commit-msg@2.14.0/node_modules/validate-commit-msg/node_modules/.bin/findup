#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="$basedir/../../../../../findup@0.1.5/node_modules"
else
  export NODE_PATH="$NODE_PATH:$basedir/../../../../../findup@0.1.5/node_modules"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../findup@0.1.5/node_modules/findup/bin/findup.js" "$@"
else
  exec node  "$basedir/../../../../../findup@0.1.5/node_modules/findup/bin/findup.js" "$@"
fi
